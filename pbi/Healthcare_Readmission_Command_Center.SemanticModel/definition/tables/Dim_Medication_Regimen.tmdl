table Dim_Medication_Regimen
	lineageTag: 20000000-0000-0000-0000-000000000001

	column med_regimen_key
		dataType: int64
		isKey
		formatString: "0"
		sourceColumn: med_regimen_key

	column medication_change
		dataType: string
		sourceColumn: medication_change

	column diabetes_med_prescribed
		dataType: string
		sourceColumn: diabetes_med_prescribed

	column insulin_status
		dataType: string
		sourceColumn: insulin_status

	column metformin_status
		dataType: string
		sourceColumn: metformin_status

	column active_med_count
		dataType: int64
		formatString: "0"
		sourceColumn: active_med_count

	partition Dim_Medication_Regimen = m
		mode: import
		source =
			let
				Source = Sql.Database(".", "diabetes_readmission", [Query="SELECT * FROM Dim_Medication_Regimen"])
			in
				Source
