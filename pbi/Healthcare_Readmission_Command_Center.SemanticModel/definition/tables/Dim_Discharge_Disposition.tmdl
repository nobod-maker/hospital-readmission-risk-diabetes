table Dim_Discharge_Disposition
	lineageTag: 20000000-0000-0000-0000-000000000001

	column discharge_disp_key
		dataType: int64
		isKey
		formatString: "0"
		sourceColumn: discharge_disp_key

	column discharge_disp_id
		dataType: int64
		formatString: "0"
		sourceColumn: discharge_disp_id

	column discharge_disp_name
		dataType: string
		sourceColumn: discharge_disp_name

	column is_hospice_deceased
		dataType: int64
		formatString: "0"
		sourceColumn: is_hospice_deceased

	partition Dim_Discharge_Disposition = m
		mode: import
		source =
			let
				Source = Sql.Database(".", "diabetes_readmission", [Query="SELECT * FROM Dim_Discharge_Disposition"])
			in
				Source
